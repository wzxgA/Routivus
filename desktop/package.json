{
  "name": "routivus-desktop",
  "productName": "Routivus",
  "version": "0.1.0",
  "private": true,
  "description": "Routivus 桌面壳：Electron 主进程负责窗口与进程生命周期，Python 后端负责业务与同源托管前端",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.3.1",
    "typescript": "^5.6.3"
  }
}

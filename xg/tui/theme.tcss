Screen {
    background: $surface;
}

#shell {
    width: 1fr;
    height: 1fr;
}

#main-column {
    width: 1fr;
    height: 1fr;
}

#header {
    height: 2fr;
    min-height: 5;
    max-height: 20;
    color: $text;
    background: $panel;
    padding: 0 2;
    content-align: center middle;
    text-align: center;
    text-style: none;
}

#header.usage-warning {
    color: $warning;
}

#header.usage-error {
    color: $error;
}

#transcript {
    width: 1fr;
    height: 8fr;
    min-height: 8;
    padding: 1 2;
    background: $surface;
    scrollbar-size: 1 1;
}

.transcript-empty-state {
    width: 1fr;
    height: auto;
    margin-top: 6;
    padding: 1 2;
    color: $text-muted;
    text-align: center;
}

.inline-action-card {
    width: 1fr;
    height: auto;
    margin: 1 0 1 0;
    padding: 1 2;
    background: $panel;
    border: round $warning;
}

.inline-approval-card {
    border: round $error;
}

.confirmation-memory_clear {
    border: round $accent;
}

.inline-action-card > Static {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
}

#inspector {
    width: 36;
    min-width: 32;
    height: 1fr;
    border-left: solid $primary;
    padding: 1;
    color: $text-muted;
}

#inspector-tabs {
    height: 2;
    width: 1fr;
    color: $text-muted;
}

InspectorTab {
    width: 1fr;
    height: 2;
    content-align: center middle;
    padding: 0;
    text-wrap: nowrap;
    overflow: hidden;
}

InspectorTab:hover {
    color: $text;
    background: $panel;
}

InspectorTab.active {
    color: $accent;
    text-style: bold;
    border-bottom: heavy $accent;
}

#inspector-content {
    height: 1fr;
    overflow-y: auto;
}

#inspector-content > Static {
    width: 1fr;
    height: auto;
    color: $text;
}

#notification {
    height: auto;
    max-height: 2;
    padding: 0 1;
    color: $warning;
}

#composer-area {
    width: 1fr;
    height: auto;
    min-height: 0;
    margin: 0;
}

#ask-panel {
    width: 1fr;
    height: auto;
    max-height: 24;
    min-height: 0;
    padding: 1 2;
    margin: 0 0 1 0;
    background: $panel;
    border-left: thick $accent;
    overflow-y: auto;
}

#ask-kicker {
    color: $accent;
    text-style: bold;
}

#ask-prompt, #ask-progress, #ask-hint {
    color: $text-muted;
}

#ask-question {
    width: 1fr;
    height: auto;
    margin-top: 1;
    color: $text;
    text-style: bold;
}

#ask-options {
    width: 1fr;
    height: auto;
    min-height: 0;
    max-height: 12;
    margin: 1 0;
    scrollbar-size: 1 1;
}

AskOptionButton {
    width: 1fr;
    height: 3;
    min-height: 3;
    padding: 0 1;
    margin: 0;
    content-align: left middle;
}

AskOptionButton.selected {
    color: $text;
    background: $accent;
    text-style: bold;
}

#ask-error {
    color: $error;
    text-style: bold;
}

#queue-status {
    height: auto;
    max-height: 5;
    padding: 0 1;
    color: $text-muted;
    background: $panel;
}

#command-suggestions {
    width: 1fr;
    height: auto;
    max-height: 8;
    padding: 0 1;
    color: $text-muted;
    background: $panel;
    border: round $primary;
    scrollbar-size: 1 1;
}

#command-suggestions > .option-list--option-highlighted {
    color: $text;
    background: $accent;
}

#composer-label {
    height: 1;
    padding: 0 1;
    color: $text;
    background: $panel;
    text-style: bold;
}

#composer {
    height: 3;
    margin: 0;
    border: round $primary;
    background: $surface;
}

#composer.ask-mode {
    border: double $accent;
}

#composer:focus {
    border: double $accent;
}

#footer {
    width: 1fr;
    height: 1;
    color: $text-muted;
    background: $panel;
    padding: 0 1;
}

ApprovalModal, PlanModal {
    align: center middle;
}

#approval-dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $panel;
    border: thick $warning;
}

#confirm-dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $panel;
    border: thick $warning;
}

#ask-dialog {
    width: 80;
    max-width: 94%;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    background: $panel;
    border: thick $accent;
}

#ask-fields {
    height: auto;
    max-height: 60%;
}

.ask-field {
    height: auto;
    padding-bottom: 1;
}

.ask-option {
    margin: 0 1 0 1;
}
